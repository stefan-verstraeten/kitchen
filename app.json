{
  "expo": {
    "name": "Kitchen",
    "slug": "kitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "be.kitchen.recipes"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "be.kitchen.recipes"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Kitchen",
      "shortName": "Kitchen",
      "themeColor": "#FBF8F3",
      "backgroundColor": "#FBF8F3",
      "lang": "nl"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing"
    ],
    "scheme": "kitchen",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/kitchen"
    }
  }
}
